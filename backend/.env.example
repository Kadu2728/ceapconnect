# Copie este arquivo para ".env" e preencha com valores reais.
# Nunca commitar o ".env" (já coberto pelo .gitignore da raiz).

# --- App ---
APP_NAME="CEAP Connect API"
APP_ENV=development
DEBUG=true

# --- Database (PostgreSQL) ---
# Formato: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
# Não inclua sslmode/channel_binding na URL (params do libpq, incompatíveis
# com o driver asyncpg) — use DATABASE_SSL=true em vez disso (necessário em
# provedores gerenciados como Neon; deixe false para Postgres local/Docker).
DATABASE_URL=postgresql+asyncpg://ceap:ceap@localhost:5432/ceap_connect
DATABASE_SSL=false

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Lista separada por vírgula das origens permitidas do frontend
CORS_ORIGINS=http://localhost:3000

# --- Assistente IA (Groq — nível gratuito) ---
# Cole sua chave do Groq (GRÁTIS, sem cartão; começa com "gsk_") para ativar o bot.
# Sem chave, o assistente responde com uma mensagem de "não configurado".
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=
# Modelo do Groq (nível gratuito). Pode deixar o padrão.
GROQ_MODEL=llama-3.3-70b-versatile
