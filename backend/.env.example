# Copie este arquivo para ".env" e preencha com valores reais.
# Nunca commitar o ".env" (já coberto pelo .gitignore da raiz).

# --- App ---
APP_NAME="CEAP Connect API"
APP_ENV=development
DEBUG=true

# --- Database (PostgreSQL) ---
# Formato: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
# Não inclua sslmode/channel_binding na URL (params do libpq, incompatíveis
# com o driver asyncpg) — use DATABASE_SSL=true em vez disso (necessário em
# provedores gerenciados como Neon; deixe false para Postgres local/Docker).
DATABASE_URL=postgresql+asyncpg://ceap:ceap@localhost:5432/ceap_connect
DATABASE_SSL=false

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Lista separada por vírgula das origens permitidas do frontend
CORS_ORIGINS=http://localhost:3000

# --- Assistente IA (Google Gemini) ---
# Cole sua chave do Google Gemini para ativar o bot.
# Sem chave, o assistente responde com uma mensagem de "não configurado".
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo do Gemini. Pode deixar o padrão.
GEMINI_MODEL=gemini-flash-lite-latest

# --- Envolver o responsável (EPIC 17) ---
# Dias após a prova usados como data provisória da entrevista.
INTERVIEW_OFFSET_DAYS=21
# Local da entrevista, exibido ao candidato e enviado ao responsável.
INTERVIEW_LOCATION="Unidade CEAP — Pedreira, São Paulo/SP"
# Chave do Resend (resend.com/api-keys) para o e-mail de aviso ao responsável.
# Sem chave, o aviso por e-mail fica indisponível (o link de WhatsApp continua
# funcionando normalmente, pois não depende de nenhum provedor externo).
RESEND_API_KEY=
# Remetente do e-mail. O domínio de teste do Resend funciona sem verificação.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Predição de evasão (EPIC 14) ---
# Chave usada por POST /internal/risk/recompute (API key de serviço, não JWT
# de usuário). Gere uma string aleatória longa; sem ela o endpoint recusa
# tudo (fail-closed) — o job in-process continua funcionando normalmente.
INTERNAL_API_KEY=
# Intervalo (minutos) do job in-process que recalcula o risco de evasão.
RISK_RECOMPUTE_INTERVAL_MINUTES=60
