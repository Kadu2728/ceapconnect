# =============================================================================
# CEAP Connect — variáveis de ambiente do docker-compose (ambiente local)
#
# Copie este arquivo para ".env" na raiz do monorepo e ajuste os valores.
# Nunca commitar o ".env" real (já coberto pelo .gitignore da raiz).
#
# Observação: DATABASE_URL NÃO é definida aqui — o docker-compose.yml a monta
# dinamicamente a partir de POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB,
# sempre apontando para o serviço interno "db" (evita as duas variáveis
# ficarem dessincronizadas). Para rodar o backend fora do Docker, use
# backend/.env.example em vez deste arquivo.
# =============================================================================

# --- PostgreSQL (serviço "db") ---
POSTGRES_USER=ceap
POSTGRES_PASSWORD=ceap
POSTGRES_DB=ceap_connect
# Porta exposta no host (fora do container) para acessar o Postgres com um
# client local (psql, DBeaver, TablePlus etc). Mude se a 5432 já estiver
# ocupada por um Postgres nativo instalado na máquina.
POSTGRES_PORT=5432

# --- Backend / API (serviço "backend") ---
APP_ENV=development
DEBUG=true
# Segredo usado para assinar os tokens JWT. Gere um valor forte, ex:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Origens (do frontend) permitidas por CORS, separadas por vírgula. Deve
# bater EXATAMENTE com a URL pública do frontend (sem barra final) — se você
# mudar FRONTEND_PORT abaixo, atualize esta variável também, senão o
# navegador vai receber erro de CORS ao chamar a API.
CORS_ORIGINS=http://localhost:3000
# Porta exposta no host para a API FastAPI.
BACKEND_PORT=8000
# Número de workers do Uvicorn. Em dev local, 1-2 é suficiente.
UVICORN_WORKERS=2

# --- Frontend (serviço "frontend") ---
# URL da API consumida pelo BROWSER do usuário — precisa ser resolvível fora
# da rede do compose (nunca use o hostname interno "backend" aqui). Em dev
# local, http://localhost:8000 é o correto — se mudar BACKEND_PORT acima,
# atualize esta URL também. É inlinada no bundle em build-time (ver
# frontend/Dockerfile), então mudar esta variável exige rebuild da imagem
# (`docker compose up --build`), não apenas restart.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Porta exposta no host para o Next.js.
FRONTEND_PORT=3000
